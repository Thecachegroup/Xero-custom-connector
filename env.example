# TCG Xero connector — environment variables
#
# Copy to .env for local runs, or set these in Vercel → Settings → Environment
# Variables for the deployment. Nothing here is optional unless marked.
#
# NOTE: the previous env.example in this repo contained a stale copy of
# mappers.py rather than any environment documentation. Replaced.

# ---------------------------------------------------------------- Xero
# From the Xero Custom Connection at https://developer.xero.com/app/manage
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# Optional. Discovered from /connections when omitted.
XERO_TENANT_ID=

# ---------------------------------------------------------------- Microsoft Graph
# From the Entra app registration ("TCG Payroll Sweep").
# Application permissions required, with admin consent granted:
#     Mail.Read              read the payroll mailbox
#     Files.ReadWrite.All    write into Contractors/Timesheets/
#
# SECURITY: Mail.Read as an APPLICATION permission reads every mailbox in the
# tenant. Restrict it to the payroll mailbox with an Application Access Policy —
# see the docstring at the top of src/graph_client.py for the exact command.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# Mailbox the timesheets and contractor invoices arrive in.
TCG_PAYROLL_MAILBOX=payroll@thecachegroup.com.au
# Whose OneDrive holds Contractors/Timesheets/. NOT the SharePoint copy under
# Shared Documents/_Andrew — that one is stale.
TCG_FILES_OWNER=andrew.hurnard@thecachegroup.com.au

# ---------------------------------------------------------------- MCP transport
# stdio for Claude Desktop / Cowork, http for the deployed endpoint.
MCP_TRANSPORT=stdio
# Required in http mode. At least 24 characters. This secret IS the lock on the
# front door — anyone with the full URL can read the whole TCG ledger.
MCP_SHARED_SECRET=

# ---------------------------------------------------------------- writes
# Every write creates DRAFTS only, but they are still off unless this is true.
TCG_WRITE_ENABLED=false

# ---------------------------------------------------------------- optional
TCG_CACHE_TTL=900
TCG_TIMEZONE=Australia/Melbourne
TCG_PAYROLL_TAX_CATEGORY=Payroll Tax
TCG_EMPLOYEE_CODES=config/employee_codes.json
TCG_NO_PAYROLL_TAX=config/no_payroll_tax.json
TCG_CONTRACTOR_MAIL=config/contractor_mail.json
# Only set for local runs that need a file on disk.
TCG_OUTPUT_DIR=
